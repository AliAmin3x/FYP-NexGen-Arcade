# MongoDB connection string
# For local dev without setup, use MongoDB Atlas free tier or a local MongoDB instance
# Or use MongoDB Atlas: https://www.mongodb.com/atlas (free tier available)
MONGODB_URI=mongodb://localhost:27017/nexgen-arcade

# Admin login credentials (used for the hardcoded admin shortcut in /api/auth/login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_before_deploying

# Stripe (optional - only needed for checkout)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
